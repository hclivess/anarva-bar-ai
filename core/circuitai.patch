+// ---- Anarva bridge: copies of what the core knows, so scripts can reason instead of guess ----
+// Values are copied into script arrays, so nothing dangles after the call.
+static CCircuitAI* bridgeAI = nullptr;
+
+// Every known enemy (LOS or radar, not hidden). flags: 1 in LOS, 2 radar-or-LOS, 4 being built, 8 paralyzed.
+// def is null for radar blips of unknown type.
+static asUINT Bridge_GetEnemies(CScriptArray* pos, CScriptArray* vel, CScriptArray* def, CScriptArray* cost, CScriptArray* flags, CScriptArray* hp, CScriptArray* built)
+{
+	const CCircuitAI::EnemyInfos& enemies = bridgeAI->GetEnemyInfos();
+	asUINT n = 0;
+	for (auto& kv : enemies) {
+		if (!kv.second->IsHidden()) ++n;
+	}
+	pos->Resize(n); vel->Resize(n); def->Resize(n); cost->Resize(n); flags->Resize(n); hp->Resize(n); built->Resize(n);
+	asUINT i = 0;
+	for (auto& kv : enemies) {
+		CEnemyInfo* e = kv.second;
+		if (e->IsHidden()) continue;
+		AIFloat3 p = e->GetPos(), v = e->GetVel();
+		CCircuitDef* d = e->GetCircuitDef();
+		float c = e->GetCost();
+		int f = (e->IsInLOS() ? 1 : 0) | (e->IsInRadarOrLOS() ? 2 : 0) | (e->IsBeingBuilt() ? 4 : 0) | (e->IsParalyzed() ? 8 : 0);
+		// health as a fraction of max, build progress 0..1; only what a player sees: known in LOS, else 1
+		float h = 1.f, b = 1.f;
+		if (e->IsInLOS() && (d != nullptr) && (d->GetHealth() > 0.f)) {
+			h = std::clamp(e->GetHealth() / d->GetHealth(), 0.f, 1.f);
+			if (e->IsBeingBuilt()) b = e->GetUnit()->GetBuildProgress();
+		}
+		pos->SetValue(i, &p); vel->SetValue(i, &v); def->SetValue(i, &d); cost->SetValue(i, &c); flags->SetValue(i, &f);
+		hp->SetValue(i, &h); built->SetValue(i, &b);
+		++i;
+	}
+	return n;
+}
