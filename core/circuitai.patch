+// Prices for a job that builds nothing (reclaim, resurrect, repair), by the same rules as below: metal at the share
+// we spend while the bank would fill; energy at what it unlocks (production's M/E while metal floats or energy binds).
+// With the old nominal metal price, reclaiming rocks (metal at ~1 while 1000 floated) beat wind in a lull with
+// energy at 1/1352 (Feast, 2026-11-25).
+static void AnarvaPlainPrices(circuit::CCircuitAI* circuit, float& pM, float& pE)
+{
+	circuit::CEconomyManager* eco = circuit->GetEconomyManager();
+	circuit::CFactoryManager* fm = circuit->GetFactoryManager();
+	const float mInc = eco->GetAvgMetalIncome();
+	pM = 1.f;
+	if (mInc > 0.f) pM = std::min(1.f, (circuit->GetBuilderManager()->GetBuildPower() + fm->GetMetalRequire()) / mInc);
+	// the same continuous metal share as the build jobs' price (spend / (income + bank over the horizon once producing)):
+	// with the old "fills within a window" gate reclaim scored 2-7 vs 50+ for everything else while the bank sat full
+	// at 1100-1250 for 8 minutes and builders reclaimed 566 times (Canis vs Cortex, cmd_m22)
+	bool producing = false;
+	for (auto& kv : circuit->GetTeamUnits()) {
+		const circuit::CCircuitDef* d = kv.second->GetCircuitDef();
+		if (d->IsMobile() && !d->IsRoleComm() && !kv.second->GetUnit()->IsBeingBuilt()) { producing = true; break; }
+	}
+	const float bank = producing ? eco->GetMetalCur() / std::max(1.f, circuit->GetMilitaryManager()->GetValueHorizon()) : 0.f;
+	const float avail = mInc + bank;
+	const bool floats = (avail > 0.f) && (eco->GetSmoothMetalPull() < avail);
+	if (floats) pM = std::min(pM, eco->GetSmoothMetalPull() / avail);
+	pE = std::max(1e-9f, eco->GetEcoEM());
+	const float pullE = eco->GetSmoothEnergyPull(), pullM = eco->GetSmoothMetalPull();
+	if (AnarvaEnergyBinds(circuit) && (pullE > 0.f)) pE = std::max(pE, pullM / pullE);
+	if (floats && (fm->GetEnergyRequire() > 0.f)) pE = std::max(pE, fm->GetMetalRequire() / fm->GetEnergyRequire());
+	if (eco->GetPlannedEnergy() > eco->GetAvgEnergyIncome()) pE = std::max(pE, eco->GetSpendMetalPerEnergy());
+}
