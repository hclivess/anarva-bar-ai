 #include "Log.h"
 
+namespace {
+// Anarva: seconds until a job does its job, the one scale every builder job shares. An economy job (it extracts or
+// makes energy) returns its cost only after paying it back: travel + build + payback, payback = cost (energy priced at
+// the converter rate) / the metal-equivalent it adds per second. Other jobs: travel + build + cost / our income. Ranking by time per
+// metal of COST made the most expensive job win: a lab before the extractors that feed it (smoke 2026-11-25).
+float AnarvaJobTime(circuit::CCircuitAI* circuit, const circuit::IBuilderTask* task, float travel, float build)
+{
+	const circuit::CCircuitDef* bd = task->GetBuildDef();
+	if (bd == nullptr) {
+		return travel + build;
+	}
+	circuit::CEconomyManager* eco = circuit->GetEconomyManager();
+	// Shadow prices, in metal: what one more unit of each resource is worth now, given which one binds.
+	//  - metal is worth nothing while it overflows (storage full, income above spending: more of it is wasted);
+	//  - energy, while it stalls, unlocks spending at our own ratio (metal pull / energy pull); otherwise it is worth
+	//    what a converter pays for surplus (GetEcoEM). The converter price alone made 14 extractors with metal full
+	//    and energy at 30/s (smoke 2026-11-25).
+	// Overflow = income beyond what we can spend, not "full now" (the game starts full: extractors read worthless).
+	// What we can spend: our builders' power at this job's metal per build time, plus what the factories draw.
+	float spendCap = circuit->GetBuilderManager()->GetBuildPower() * bd->GetCostM() / std::max(1.f, bd->GetBuildTime())
+		+ circuit->GetFactoryManager()->GetMetalRequire();
+	// Build power spends nothing without energy: we can spend at most our energy income at the metal per energy of what
+	// we build (Avalanche 2026-11-25: metal full at 1300, energy at 0-76 for 6 minutes, extractors still ranked level
+	// with wind and the army stayed at 43-129 metal)
+	if (eco->GetSpendMetalPerEnergy() > 0.f) {
+		spendCap = std::min(spendCap, eco->GetAvgEnergyIncome() * eco->GetSpendMetalPerEnergy());
+	}
+	// The price of one more metal = the share of our metal income we can actually spend now (capacity / income, at
+	// most 1). "Storage full" read 900/1250 as fine while it piled up unspendable.
+	const float mInc = eco->GetAvgMetalIncome();
+	const float pM = (mInc > 0.f) ? std::min(1.f, spendCap / mInc) : 1.f;
+	float pE = std::max(1e-9f, eco->GetEcoEM());
+	// converters draw exactly the surplus: judge deficit and spending ratio on the pull without them (owner, #83)
+	const float realPullE = eco->GetEnergyPullReal();
+	const bool energyBinds = eco->IsEnergyStalling() || (realPullE > eco->GetAvgEnergyIncome());  // stall or deficit
+	if (energyBinds && (realPullE > 0.f) && (eco->GetMetalPull() > 0.f)) {
+		pE = std::max(pE, eco->GetMetalPull() / realPullE);
+	}
+	// think ahead (#86): when spending our metal income will need more energy than we make, energy binds already,
+	// at the metal-per-energy of what we build (wind read 277 s vs an extractor's 41 s while energy was about to bind)
+	// a factory waiting for energy (IsEnergyRequired) binds energy too: otherwise its plants lost to other jobs and
+	// the second factory never came (Throne 2026-11-25: 3500 metal banked, one lab, "energy required" for 9 minutes)
+	if (((eco->GetPlannedEnergy() > eco->GetAvgEnergyIncome()) || eco->IsEnergyRequired()) && (eco->GetSpendMetalPerEnergy() > 0.f)) {
+		pE = std::max(pE, eco->GetSpendMetalPerEnergy());
+	}
+	float yield = 0.f;  // metal-equivalent per second
+	if (bd->GetExtractsM() > 0.f) {
+		yield += circuit->GetMetalManager()->GetSpotAvgIncome() * bd->GetExtractsM() * pM;
+	}
+	yield += eco->GetEnergyMake(const_cast<circuit::CCircuitDef*>(bd)) * pE;
+	// A job without a yield (lab, turret) is paid back by our income instead: the time our income needs to earn
+	// its cost. Without this it looked quicker than any extractor (no payback term) and the lab came first at 2 M/s.
+	const float cost = bd->GetCostM() * pM + bd->GetCostE() * pE;
+	const bool producer = (bd->GetExtractsM() > 0.f) || (eco->GetEnergyMake(const_cast<circuit::CCircuitDef*>(bd)) > 0.f);
+	const float income = eco->GetAvgMetalIncome() * pM + eco->GetAvgEnergyIncome() * pE;
+	if (!producer) {
+		// paid from what we hold first, then from income: banked metal is idle capital (1150 sat full while the lab
+		// waited for income to "earn" it, the lab came at 160 s and the first raid found no army, 2026-11-25)
+		const float stock = eco->GetMetalCur() * pM + eco->GetEnergyCur() * pE;
+		const float owed = std::max(0.f, cost - stock);
+		return travel + build + ((owed > 0.f) ? owed / std::max(1e-3f, income) : 0.f);
+	}
+	if (yield <= 0.f) {
+		return travel + build + 1e9f;  // pays nothing back at these prices (e.g. an extractor while metal overflows)
+	}
+	return travel + build + cost / yield;
+}
+
+// Anarva (#88): every builder pick is logged with the best job of each other type, in the same seconds, so every
+// economic choice can be read from the log.
+struct AnarvaPickLog {
+	std::map<int, std::pair<double, const circuit::IBuilderTask*>> best;
+	void Note(const circuit::IBuilderTask* t, double key) {
+		auto it = best.find((int)t->GetBuildType());
+		if ((it == best.end()) || (key < it->second.first)) {
+			best[(int)t->GetBuildType()] = std::make_pair(key, t);
+		}
+	}
+	void Write(circuit::CCircuitAI* circuit, circuit::CCircuitUnit* unit, const circuit::IBuilderTask* chosen) const {
+		if (chosen == nullptr) {
+			return;
+		}
+		auto name = [](const circuit::IBuilderTask* t) { return (t->GetBuildDef() != nullptr) ? t->GetBuildDef()->GetDef()->GetName() : "-"; };
+		std::string s;
+		for (const auto& kv : best) {
+			char buf[96];
+			snprintf(buf, sizeof(buf), " %d:%s=%.0f", kv.first, name(kv.second.second), std::fmod(kv.second.first, 1e10));
+			s += buf;
+		}
+		circuit::CEconomyManager* eco = circuit->GetEconomyManager();
+		circuit->LOG("[ANV-PICK] f=%d %s -> %d:%s | best per type (type:def=seconds):%s | M %.0f/%.0f E %.0f/%.0f",
+			circuit->GetLastFrame(), unit->GetCircuitDef()->GetDef()->GetName(), (int)chosen->GetBuildType(), name(chosen), s.c_str(),
+			eco->GetMetalCur(), eco->GetMetalStorage(), eco->GetEnergyCur(), eco->GetEnergyStorage());
+	}
+};
+// Priority band first, then seconds. Packed as band x 1e10 + seconds in a double (53-bit mantissa: bands up to 99
+// keep 1e-4 s resolution). It was band x 1e12 + seconds in a float (24 bits): the seconds vanished below the
+// float's resolution, every job in a band tied, and the loop's first type (energy) always won (smoke 2026-11-25).
+double AnarvaJobKey(float rank, float seconds)
+{
+	return double(rank) * 1e10 + std::min<double>(double(seconds), 1e9);
+}
