+// Can a unit of this type walk/drive/float from one point to another on this map (its own movement area)? Air: yes.
+static bool Bridge_DefCanReach(CCircuitDef* d, const AIFloat3& from, const AIFloat3& to)
+{
+	if (d == nullptr) return false;
+	if (d->IsAbleToFly()) return true;
+	CTerrainManager* tm = bridgeAI->GetTerrainManager();
+	terrain::SArea* area = tm->GetCurrentMapArea(d, from).first;
+	if (area == nullptr) return tm->GetCurrentMapArea(d, from).second;  // (second: the whole map is one area for it)
+	return tm->CanMobileReachAt(area, to, 0.f);
+}
+// Anarva: the walk a unit of this type has from one point to another (the engine's path length; the straight line if
+// it has none) - a straight-line walk priced the commander's third extractor at 9 s when it took 20+ (Canis spot 49)
+static float Bridge_PathLength(CCircuitDef* d, const AIFloat3& from, const AIFloat3& to)
+{
+	const float straight = from.distance2D(to);
+	if ((d == nullptr) || d->IsAbleToFly() || (d->GetDef() == nullptr)) return straight;
+	springai::MoveData* md = d->GetDef()->GetMoveData();
+	if (md == nullptr) return straight;
+	const int pathType = md->GetPathType();
+	delete md;
+	const float len = bridgeAI->GetPathing()->GetApproximateLength(from, to, pathType, 0.0f);
+	return (len > 0.f) ? std::max(len, straight) : straight;
+}
+// Can this building (a factory, say) stand here (its terrain type: a shipyard needs water)?
+static bool Bridge_CanBeBuiltAt(CCircuitDef* d, const AIFloat3& pos)
+{
+	return (d != nullptr) && bridgeAI->GetTerrainManager()->CanBeBuiltAt(d, pos);
+}
