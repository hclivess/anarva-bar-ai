+bool CArtilleryTask::ToFiringSpot(CCircuitUnit* unit, const AIFloat3& pos)
+{
+	// Where can this unit fire from soonest? A spot qualifies when the target is inside the unit's
+	// range *from that spot's height* (engine ballistic rule) and the threat map says nothing can hit
+	// it there. Among qualifying spots the one with the shortest trip wins: high ground widens the
+	// qualifying set outward, so it is chosen exactly when it buys reach or safety, never by a bonus.
+	if (enemyPositions.empty()) {
+		return false;
+	}
+	CCircuitAI* circuit = manager->GetCircuit();
+	CCircuitDef* cdef = unit->GetCircuitDef();
+	CThreatMap* threatMap = circuit->GetThreatMap();
+	terrain::SAreaData* areaData = circuit->GetTerrainManager()->GetAreaData();
+	CTerrainManager* terrainMgr = circuit->GetTerrainManager();
+	const float step = threatMap->GetSquareSize();  // resolution of what we know about danger
+	const float maxX = CTerrainManager::GetTerrainWidth() - 1.f, maxZ = CTerrainManager::GetTerrainHeight() - 1.f;
+	threatMap->SetThreatType(unit);
+
+	std::vector<std::pair<float, AIFloat3>> order;  // lower bound on trip length, target
+	order.reserve(enemyPositions.size());
+	for (const AIFloat3& t : enemyPositions) {
+		const float rMax = cdef->GetRangeAt(t.y - areaData->maxElevation);
+		order.emplace_back(std::max(0.f, pos.distance2D(t) - std::max(rMax, cdef->GetMaxRange())), t);
+	}
+	std::sort(order.begin(), order.end(), [](const auto& a, const auto& b) { return a.first < b.first; });
+
+	float best = std::numeric_limits<float>::max();
+	AIFloat3 bestPos = -RgtVector;
+	for (const auto& [bound, t] : order) {
+		if (bound >= best) {
+			break;  // no spot around this or any later target can be reached sooner
+		}
+		const float rMax = std::max(cdef->GetRangeAt(t.y - areaData->maxElevation), cdef->GetMaxRange());
+		for (float r = step; r <= rMax; r += step) {
+			const int n = std::max(8, (int)std::ceil(2.f * (float)M_PI * r / step));
+			for (int i = 0; i < n; ++i) {
+				const float a = 2.f * (float)M_PI * i / n;
+				AIFloat3 c(t.x + r * std::cos(a), 0.f, t.z + r * std::sin(a));
+				if ((c.x < 0.f) || (c.z < 0.f) || (c.x > maxX) || (c.z > maxZ)) {
+					continue;
+				}
+				const float trip = pos.distance2D(c);
+				if (trip >= best) {
+					continue;
+				}
+				c.y = areaData->GetElevationAt(c.x, c.z);
+				if (r > cdef->GetRangeAt(t.y - c.y)) {
+					continue;
+				}
+				if (threatMap->GetThreatAt(c) > THREAT_MIN) {
+					continue;
+				}
+				if (!terrainMgr->CanMoveToPos(unit->GetArea(), c)) {
+					continue;
+				}
+				best = trip;
+				bestPos = c;
+			}
+		}
