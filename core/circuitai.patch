+// Anarva (#89): where a raid with nothing in sight should go: the enemy economy the script expects (value), per
+// second of travel, among spots whose threat is below the raid's power (turrets and armies on the threat map).
+AIFloat3 CMilitaryManager::GetRaidPosition(CCircuitUnit* leader, float power)
+{
+	CTerrainManager* terrainMgr = circuit->GetTerrainManager();
+	CThreatMap* threatMap = circuit->GetThreatMap();
+	threatMap->SetThreatType(leader);
+	const AIFloat3& from = leader->GetPos(circuit->GetLastFrame());
+	const float speed = std::max(1.f, leader->GetCircuitDef()->GetSpeed());
+	SArea* area = leader->GetArea();
+	float bestScore = 0.f;
+	AIFloat3 best = -RgtVector;
+	for (size_t i = 0; i < scriptRaidPos.size(); ++i) {
+		const AIFloat3& p = scriptRaidPos[i];
+		if ((scriptRaidVal[i] <= 0.f) || !terrainMgr->CanMoveToPos(area, p) || (threatMap->GetThreatAt(p) >= power)) {
+			continue;
+		}
+		const float score = scriptRaidVal[i] / std::max(1.f, from.distance2D(p) / speed);
+		if (score > bestScore) {
+			bestScore = score;
+			best = p;
+		}
+	}
+	return best;
+}
