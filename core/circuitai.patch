+// Anarva: how long a reclaim/resurrect job takes this builder: the engine's rule, each feature's reclaim time over the
+// builder's reclaim speed, for the features in its reach of the job. (Counted as 0, a wreck looked instant and beat
+// building wind while energy stalled: reclaim 1.7 vs wind 38 builder-ms per metal, Theta Crystals 2026-11-25.)
+float AnarvaReclaimTime(circuit::CCircuitAI* circuit, const circuit::IBuilderTask* task, const circuit::CCircuitDef* cdef)
+{
+	using namespace circuit;
+	const IBuilderTask::BuildType bt = task->GetBuildType();
+	if ((bt != IBuilderTask::BuildType::RECLAIM) && (bt != IBuilderTask::BuildType::RESURRECT)) return 0.f;
+	const float speed = std::max(1e-3f, const_cast<CCircuitDef*>(cdef)->GetDef()->GetReclaimSpeed());
+	// a unit target: its build time x how far it was built, at our reclaim speed (counted as 0 s, with no features)
+	if (task->GetTarget() != nullptr) {
+		CCircuitUnit* tu = task->GetTarget();
+		const float progress = tu->IsFinished() ? 1.f : std::max(0.f, tu->GetUnit()->GetBuildProgress());
+		return tu->GetCircuitDef()->GetBuildTime() * progress / speed;
+	}
+	// the same features the task's value counts (its area), not only those in this builder's reach of its centre: with
+	// a field's metal credited against a few rocks' reclaim time, reclaim scored 2.27 vs an extractor's 76 and builders
+	// reclaimed 361 times in minutes 2-7.5 with 3 extractors at 5:00 (Canis vs Cortex, cmd_m42)
+	float area = std::max(SQUARE_SIZE * 1.f, cdef->GetBuildDistance());
+	if (const IReclaimTask* rt = dynamic_cast<const IReclaimTask*>(task)) area = std::max(area, rt->GetRadius());
+	auto features = circuit->GetCallback()->GetFeaturesIn(task->GetPosition(), area);
+	float t = 0.f;
+	const int nFeatures = (int)features.size();
+	for (springai::Feature* f : features) {
+		springai::FeatureDef* fd = f->GetDef();
+		if (fd != nullptr) {
+			if (fd->IsReclaimable()) t += fd->GetReclaimTime() * f->GetReclaimLeft();
+			delete fd;
+		}
+	}
+	utils::free_clear(features);
+	{  // Anarva: the reclaim time's inputs, once per 10 s
+		static int lastT = -1000000;
+		const int fr = circuit->GetLastFrame();
+		if (fr - lastT >= 300) {
+			lastT = fr;
+			circuit->LOG("[ANV-RECTIME] f=%d features %d sumReclaimTime %.1f reclaimSpeed %.1f -> %.1f s (buildSpeed %.0f)",
+				fr, nFeatures, t, speed, t / speed, cdef->GetBuildSpeed());
+		}
+	}
+	return t / speed;
+}
