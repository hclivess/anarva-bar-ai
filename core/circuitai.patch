+
 AIFloat3 CMilitaryManager::GetScoutPosition(CCircuitUnit* unit)
 {
+	if (anarva::switches.scoutMap && !scriptScoutPos.empty()) {
+		// Anarva: the script ranks where vision is worth most (age x stake). Take the most valuable target this
+		// scout can reach; each target goes to one scout (removed once handed out; the script refreshes the list).
+		CTerrainManager* terrainMgr = circuit->GetTerrainManager();
+		SArea* area = unit->GetArea();
+		int best = -1;
+		for (size_t i = 0; i < scriptScoutPos.size(); ++i) {
+			if (!terrainMgr->CanMoveToPos(area, scriptScoutPos[i])) {
+				continue;
+			}
+			if ((best < 0) || (scriptScoutVal[i] > scriptScoutVal[best])) {
+				best = i;
+			}
+		}
+		if (best >= 0) {
+			const AIFloat3 p = scriptScoutPos[best];
+			scriptScoutPos.erase(scriptScoutPos.begin() + best);
+			scriptScoutVal.erase(scriptScoutVal.begin() + best);
+			return p;
+		}
+	}
 	ClearScoutPosition(unit->GetTask());
 	CMetalManager* metalMgr = circuit->GetMetalManager();
 	const CMetalData::Clusters& clusters = metalMgr->GetClusters();
