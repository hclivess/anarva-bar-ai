+// The core's own clustering of enemy units: centre, metal cost, threat (influence).
+static asUINT Bridge_GetEnemyGroups(CScriptArray* pos, CScriptArray* cost, CScriptArray* threat)
+{
+	const auto& groups = bridgeAI->GetEnemyManager()->GetEnemyGroups();
+	const asUINT n = groups.size();
+	pos->Resize(n); cost->Resize(n); threat->Resize(n);
+	for (asUINT i = 0; i < n; ++i) {
+		AIFloat3 p = groups[i].pos;
+		float c = groups[i].cost, t = groups[i].influence;
+		pos->SetValue(i, &p); cost->SetValue(i, &c); threat->SetValue(i, &t);
+	}
+	return n;
+}
