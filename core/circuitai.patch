+// Every metal spot: position, income, open (not ours or queued by us/allies).
+static asUINT Bridge_GetMetalSpots(CScriptArray* pos, CScriptArray* income, CScriptArray* open)
+{
+	CMetalManager* mm = bridgeAI->GetMetalManager();
+	const CMetalData::Metals& spots = mm->GetSpots();
+	const asUINT n = spots.size();
+	pos->Resize(n); income->Resize(n); open->Resize(n);
+	for (asUINT i = 0; i < n; ++i) {
+		AIFloat3 p = spots[i].position;
+		float inc = spots[i].income;
+		bool o = mm->IsOpenSpot(int(i));
+		pos->SetValue(i, &p); income->SetValue(i, &inc); open->SetValue(i, &o);
+	}
+	return n;
+}
