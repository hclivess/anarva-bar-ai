+// lab ran all game while the bank sat full for minutes 6-9 (Gasbag, round 32; winners 2.5 factories at minute 12).
+static float AnarvaFloatWindow(circuit::CCircuitAI* circuit)
+{
+	circuit::CEconomyManager* eco = circuit->GetEconomyManager();
+	circuit::CBuilderManager* bm = circuit->GetBuilderManager();
+	const float avgBp = std::max(1.f, bm->GetBuildPower() / std::max(1.f, float(bm->GetWorkerCount())));
+	(void)eco; (void)avgBp;
+	// (Over the build-power build time the start bank counted as floating and early extractors lost their worth: one
+	// extractor at minute 4 on Feast and Canis, short test s39. Back to one job's time.)
+	return AnarvaJobWindow(circuit);
