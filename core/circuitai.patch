+static asUINT Bridge_GetEnemyIds(CScriptArray* ids)
+{
+	const CCircuitAI::EnemyInfos& enemies = bridgeAI->GetEnemyInfos();
+	ids->Resize(0);
+	for (auto& kv : enemies) {
