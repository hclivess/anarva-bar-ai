+float CCircuitDef::GetRangeAt(float heightDiff) const
+{
+	const SRangeModel& m = rangeModel;
+	const float ydiff = heightDiff * m.heightMod;  // CWeapon::TestRange feeds heightDiff * heightmod
+	switch (m.kind) {
+		case 2: return std::max(0.f, m.range + ydiff);  // CStarburstLauncher
+		case 1: {  // CCannon::GetStaticRange2D
+			if (m.gravity >= 0.f) {
+				return m.range;
+			}
+			float h = ydiff;
+			const float smooth = 100.f;  // engine constant
+			if (h < -smooth) {
+				h *= m.heightBoost;
+			} else if (h < 0.f) {
+				h *= (1.f + (m.heightBoost - 1.f) * -h / smooth);
+			}
+			const float s2 = m.speed * 0.7071067f;
+			const float root = s2 * s2 + 2.f * m.gravity * h;
+			if (root < 0.f) {
+				return 0.f;
+			}
+			return m.rangeBoost * (s2 * s2 + s2 * std::sqrt(root)) / -m.gravity;
+		}
+		default: {  // CWeapon::GetRange2D: sphere
+			const float r = m.range * m.range - ydiff * ydiff;
+			return std::sqrt(std::max(r, 0.f));
+		}
+	}
