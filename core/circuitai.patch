+/*
+ * AnarvaSwitches.h
+ *
+ * Every behaviour change Anarva makes in the core is a switch, off by default, set from script
+ * (AiSwitch_*). With all switches off the core behaves exactly like BARb's; the script bridge only
+ * adds read access. That keeps each change measurable on its own.
+ */
+
+#ifndef SRC_CIRCUIT_UTIL_ANARVASWITCHES_H_
+#define SRC_CIRCUIT_UTIL_ANARVASWITCHES_H_
+
+namespace circuit {
+namespace anarva {
+
+struct SSwitches {
+	bool highGroundArty = false;  // artillery: height-aware range, firing spot reached soonest
+	bool heightSquads = false;    // squads: each unit's standoff scaled by its range at the height it stands on
+	bool scoutMap = false;
+	bool engageSeen = false;
+	bool decide = false;
+	bool focusFire = false;
+	bool strafe = false;          // in fights, units sidestep shots slow enough to dodge (flight time x our speed > blast radius)       // each unit focuses the visible enemy in its range with the highest threat per remaining health          // every dice roll in the core replaced by a computed choice (AUDIT.md)      // gathering squads also fight enemies inside their own sight that they can beat, not only inside our defence influence        // scouts go to the targets the script ranks (vision age x stake), not the core's cluster order
+};
+inline SSwitches switches;
+
+} // namespace anarva
+} // namespace circuit
+
+#endif // SRC_CIRCUIT_UTIL_ANARVASWITCHES_H_
