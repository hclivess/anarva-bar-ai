+// Do we see this spot right now (our line of sight, as of the core's last LOS refresh)?
+
+// Anarva: what an energy plant actually makes on this map: its fixed make, tidal generators at the map's tidal
+// strength, wind generators at the map's average wind (capped by the generator's own maximum).
+static float Bridge_EnergyMake(CCircuitDef* cdef)
+{
+	if (cdef == nullptr) {
+		return 0.f;
+	}
+	springai::Resource* e = bridgeAI->GetEconomyManager()->GetEnergyRes();
+	springai::UnitDef* def = cdef->GetDef();
+	CMap* map = bridgeAI->GetMap();
+	const float avgWind = 0.5f * (map->GetMinWind() + map->GetMaxWind());
