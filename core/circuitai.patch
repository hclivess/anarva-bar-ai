diff --git a/src/circuit/util/AnarvaDecide.h b/src/circuit/util/AnarvaDecide.h
new file mode 100644
index 00000000..6e04da05
--- /dev/null
+++ b/src/circuit/util/AnarvaDecide.h
@@ -0,0 +1,84 @@
+/*
+ * AnarvaDecide.h
+ *
+ * Systematic replacements for the core's dice (switch anarva::switches.decide). No randomness: a choice among
+ * weighted candidates goes to the one furthest below its target share of what we have.
+ */
+
+#ifndef SRC_CIRCUIT_UTIL_ANARVADECIDE_H_
+#define SRC_CIRCUIT_UTIL_ANARVADECIDE_H_
+
+#include "unit/CircuitDef.h"
+#include "unit/CircuitUnit.h"
+#include "map/ThreatMap.h"
+#include "map/InfluenceMap.h"
+#include "setup/SetupManager.h"
+#include "CircuitAI.h"
+
+#include <vector>
+#include <limits>
+
+namespace circuit {
+namespace anarva {
+
+// Largest deficit: target share = weight / total weight; current share = alive count x metal cost / total over
+// the candidates. Returns the index furthest below its target (ties: the cheaper). With no weights at all, the
+// cheapest candidate. -1 if empty.
+template <class T, class GetDef, class GetWeight>
+int DeficitPick(const std::vector<T>& cands, GetDef getDef, GetWeight getWeight)
+{
+	if (cands.empty()) {
+		return -1;
+	}
+	float sumW = 0.f, sumHave = 0.f;
+	for (const T& c : cands) {
+		sumW += getWeight(c);
+		const CCircuitDef* d = getDef(c);
+		sumHave += d->GetCount() * d->GetCostM();
+	}
+	int best = -1;
+	float bestGap = -std::numeric_limits<float>::max();
+	for (int i = 0; i < (int)cands.size(); ++i) {
+		const CCircuitDef* d = getDef(cands[i]);
+		const float want = (sumW > 0.f) ? getWeight(cands[i]) / sumW : 0.f;
+		const float have = (sumHave > 0.f) ? d->GetCount() * d->GetCostM() / sumHave : 0.f;
+		const float gap = (sumW > 0.f) ? (want - have) : -d->GetCostM();
+		if ((gap > bestGap) || ((gap == bestGap) && (best >= 0) && (d->GetCostM() < getDef(cands[best])->GetCostM()))) {
+			bestGap = gap;
+			best = i;
+		}
+	}
+	return best;
+}
+
+
+// Retreat as a decision (replaces the random retreat health fraction). A damaged unit leaves when the fight where it
+// stands is going against us (enemy threat there above our influence) and it can still get out: its health lasts
+// longer under the incoming damage (the threat map's value there) than its trip home. If it can't get out, running
+// only wastes the damage it can still deal; if the fight is ours, it stays.
+inline bool ShouldRetreat(CCircuitAI* circuit, CCircuitUnit* unit)
+{
+	const int frame = circuit->GetLastFrame();
+	const springai::AIFloat3& pos = unit->GetPos(frame);
+	CThreatMap* threatMap = circuit->GetThreatMap();
+	threatMap->SetThreatType(unit);
+	const float incoming = threatMap->GetThreatAt(unit, pos);
+	if (incoming <= 0.f) {
+		return false;  // nothing can hit it here
+	}
+	const float ours = circuit->GetInflMap()->GetAllyInflAt(pos);
+	const float theirs = circuit->GetInflMap()->GetEnemyInflAt(pos);
+	if (ours > theirs) {
+		return false;  // the fight here is ours
+	}
+	const CCircuitDef* cdef = unit->GetCircuitDef();
+	const float health = unit->GetHealthPercent() * cdef->GetHealth();
+	const float tKill = health / incoming;
+	const float tHome = circuit->GetSetupManager()->GetBasePos().distance2D(pos) / std::max(1.f, cdef->GetSpeed());
+	return tKill > tHome;
+}
+
+} // namespace anarva
+} // namespace circuit
+
+#endif // SRC_CIRCUIT_UTIL_ANARVADECIDE_H_
