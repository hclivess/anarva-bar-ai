+static CScriptArray* Bridge_GetTeamUnits()
+{
+	asIScriptEngine* engine = asGetActiveContext()->GetEngine();
+	auto cache = static_cast<CScriptManager::STypeInfoCache*>(engine->GetUserData());
+	const CCircuitAI::Units& units = bridgeAI->GetTeamUnits();
+	CScriptArray* arr = CScriptArray::Create(cache->unitArray, units.size());
+	asUINT i = 0;
+	for (auto& kv : units) {
+		CCircuitUnit* u = kv.second;
+		arr->SetValue(i++, &u);
+	}
+	return arr;
+}
