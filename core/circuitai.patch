+void CEconomyManager::UpdateEnergyPlan()
+{
+	if (energyPlanFrame == circuit->GetLastFrame()) {
+		return;
+	}
+	energyPlanFrame = circuit->GetLastFrame();
+	UpdateWind();
+	CBuilderManager* builderMgr = circuit->GetBuilderManager();
+	// what we have chosen to build so far (our built units' costs, commander excluded: it was given, not chosen).
+	// What we will spend on is mostly what our factories make: add the mobile units each factory we own or have
+	// queued can build (a Pawn costs ~17 E per M; built structures alone read ~2 at the start, no energy was
+	// planned, the lab sat at the energy's pace with metal banked: 1v1 Avalanche 2026-11-25).
+	float sumE = 0.f, sumM = 0.f;
+	auto addOptions = [&sumE, &sumM, this](const CCircuitDef* fac) {
+		for (CCircuitDef::Id id : fac->GetBuildOptions()) {
+			const CCircuitDef* o = circuit->GetCircuitDef(id);
+			if ((o != nullptr) && o->IsMobile()) {
+				sumE += o->GetCostE();
+				sumM += o->GetCostM();
+			}
+		}
+	};
+	// Once our factories have made something, what they actually made is the measure; every option counted
+	// equally over-planned energy (E/M income 18-32 at minute 8 vs 10-15 for the winners, 1v1 replays).
+	bool producedMobile = false;
+	std::vector<const CCircuitDef*> facs;
+	for (const auto& kv : circuit->GetTeamUnits()) {
+		const CCircuitDef* d = kv.second->GetCircuitDef();
+		if (d->IsRoleComm()) {
+			continue;
+		}
+		sumE += d->GetCostE();
+		sumM += d->GetCostM();
+		producedMobile |= d->IsMobile();
+		if (!d->IsMobile() && !d->GetBuildOptions().empty()) {
+			facs.push_back(d);
+		}
+	}
+	if (!producedMobile) {
+		for (const CCircuitDef* f : facs) {
+			addOptions(f);
+		}
+		for (IBuilderTask* t : builderMgr->GetTasks(IBuilderTask::BuildType::FACTORY)) {
+			if (t->GetBuildDef() != nullptr) {
+				addOptions(t->GetBuildDef());
+			}
+		}
+	}
+	// What we actually demand, smoothed: energy and metal pull (demand, also while stalled), each frame weighted by the
+	// elapsed time over the script's planning horizon. Built-structure costs diluted the ratio (~5 E/M, energy never
+	// looked short); production options alone over-planned (~16); the winners run ~10 (replays.db). Until demand data
+	// exists the cost ratio above stands in.
+	const int f = circuit->GetLastFrame();
+	// Smoothed over the time a builder commits to one job (an extractor's build time at our average builder's build
+	// power): long enough that a second's stall doesn't flip the prices, short enough to follow the economy. Starts
+	// from the first reading. (Over the whole horizon it barely moved; from 0 it never bound early.)
+	CBuilderManager* bm = circuit->GetBuilderManager();
+	const float avgBp = bm->GetBuildPower() / std::max(1.f, float(bm->GetWorkerCount()));
+	CCircuitDef* mexDef = GetSideInfo().mexDef;
+	const float window = std::max(1.f, (mexDef != nullptr) ? mexDef->GetBuildTime() / std::max(1.f, avgBp) : 1.f) * FRAMES_PER_SEC;
+	const float w = std::min(1.f, float(f - demandFrame) / window);
+	demandFrame = f;
+	// What spending the metal draws, not what building the plants draws: a plant under construction pulls its own
+	// energy (advanced solars are energy-costly), and counted in the ratio every plant raised the plan that ordered the
+	// next one - 330 -> 800-900 E/s, 1342 E/s with 3860 banked at 12:00 and the army 603 (en5).
+	float plantE = 0.f, plantM = 0.f;
+	for (IBuilderTask* t : builderMgr->GetTasks(IBuilderTask::BuildType::ENERGY)) {
+		const CCircuitDef* bd = t->GetBuildDef();
+		if ((bd == nullptr) || (bd->GetBuildTime() <= 0.f)) continue;
+		float bp = 0.f;
+		for (CCircuitUnit* a : t->GetAssignees()) bp += a->GetCircuitDef()->GetBuildSpeed();
+		plantE += bp * bd->GetCostE() / bd->GetBuildTime();
+		plantM += bp * bd->GetCostM() / bd->GetBuildTime();
+	}
+	const float mPull = std::max(0.f, GetMetalPull() - plantM);
+	const float ePullS = std::max(0.f, GetEnergyPullReal() - plantE);
+	if (mPull > 0.f) {
+		if (demandM <= 0.f) { demandE = ePullS; demandM = mPull; }
+		demandE = demandE * (1.f - w) + ePullS * w;
+		demandM = demandM * (1.f - w) + mPull * w;
+	}
+	float ratio = (sumM > 0.f) ? sumE / sumM : 0.f;  // E per M
+	if (demandM > 0.f) {
+		ratio = demandE / demandM;
+	}
+	// the metal we will spend is our income plus the bank spent over the horizon (as AnarvaSpendable counts it): a player
+	// spends a full bank, and that takes energy too. With income alone the plan read ~income, a plant's energy was worth
+	// the converter price, 990 metal sat banked and energy stalled from minute 7 (Canis vs Cortex, 2026-11-26).
+	// ...spent as fast as our build power can turn it into things, not over the planning horizon: the bank drains at
+	// the metal our builders and factories pull when all are busy (each one's build power x the metal per build-second
+	// of what it can build, unit facts). Over the horizon (10711 s early, no losses yet) 562 banked added 0.05 M/s:
+	// the plan read 70 E/s at 2:00 against the winners' 174 and the bank stood at 500 vs their 214 (replays.db, 24
+	// Armada bot-lab 1v1 wins; fg1).
+	float pullCap = 0.f;
+	for (auto& kv : circuit->GetTeamUnits()) {
+		const CCircuitDef* ud = kv.second->GetCircuitDef();
+		if (ud->GetBuildSpeed() <= 0.f || kv.second->GetUnit()->IsBeingBuilt()) continue;
+		float sum = 0.f; int n = 0;
+		for (CCircuitDef::Id id : ud->GetBuildOptions()) {
+			const CCircuitDef* o = circuit->GetCircuitDef(id);
+			if ((o != nullptr) && (o->GetBuildTime() > 0.f)) { sum += o->GetCostM() / o->GetBuildTime(); ++n; }
+		}
+		if (n > 0) pullCap += ud->GetBuildSpeed() * sum / float(n);
+	}
+	// The bank funds extra spending only for as long as it lasts: over the time a builder commits to one job (the window
+	// above, in which a new plant comes online) it adds bank / window, at most what our idle build power can pull.
+	// As bank / drain time it asked full capacity for any bank at all - 44 metal planned like 500: 673 E/s at 8:00
+	// against BARb's 500, 2543 energy banked and the army 378 vs 2485 (en2).
+	// ...but a bank is spent once and a plant stands for good: a plant for the bank's extra spending x is used only
+	// while the bank lasts (bank / x), making make x bank / x energy = make x bank / (x ratio) metal of production -
+	// worth its cost while that is at least its cost. So the bank's extra energy is at most bank x the best plant's
+	// make per metal (unit facts). As bank / job window it planned 1280 E/s against a real draw of 400-577 at 10-11
+	// min and 9 advanced solars in 2 minutes (en4: 1020 E/s at 12:00, the army 1824 vs 6615).
+	float makePerM = 0.f;
+	for (const auto& i : energyDefs.GetInfos()) {
+		if (!i.cdef->IsAvailable(f) || (i.cdef->GetCostM() <= 0.f)) continue;
+		makePerM = std::max(makePerM, i.data.make / i.cdef->GetCostM());
+	}
+	const float extraE = std::min(std::max(0.f, pullCap - GetAvgMetalIncome()) * ratio, GetMetalCur() * makePerM);
+	plannedEnergy = GetAvgMetalIncome() * ratio + extraE;  // for the builders' shadow price of energy
+	// A player knows the lab's draw before it starts: the moment a factory stands it pulls its build power x the
+	// energy per build-second of what it makes. The current mix (extractors, the lab itself: ~3 E/M) planned 19 E/s
+	// while the lab was about to draw ~80; energy was never priced ahead and stood at 57 vs the winners' 193 at
+	// minute 3 (Feast of Hades, round 27, 2026-11-25). Running factories: what they draw; standing or queued ones
+	// not yet drawing: their options' mean E per build-second. Builders' own draw comes on top.
+	{
+		CFactoryManager* fm = circuit->GetFactoryManager();
+		const float running = fm->GetEnergyRequire();
+		auto drawOf = [this](const CCircuitDef* fac) {
+			float sum = 0.f; int n = 0;
+			for (CCircuitDef::Id id : fac->GetBuildOptions()) {
+				const CCircuitDef* o = circuit->GetCircuitDef(id);
+				if ((o != nullptr) && o->IsMobile() && (o->GetBuildTime() > 0.f)) { sum += o->GetCostE() / o->GetBuildTime(); ++n; }
+			}
+			return (n > 0) ? fac->GetBuildSpeed() * sum / float(n) : 0.f;
+		};
+		float idleFac = 0.f;
+		if (running <= 0.f) {
+			for (const CCircuitDef* fd : facs) idleFac += drawOf(fd);
+			for (IBuilderTask* t : builderMgr->GetTasks(IBuilderTask::BuildType::FACTORY)) {
+				if (t->GetBuildDef() != nullptr) idleFac += drawOf(t->GetBuildDef());
+			}
+		}
+		const float builders = std::max(0.f, demandE - running);
+		{  // Anarva: the plan's inputs, every 30 s (it read 2x the real draw: 400 vs 79 at 2:00, 540 vs 212 at 8:00, en8)
+			static int lastPlanLog = -100000;
+			if (f - lastPlanLog >= 30 * FRAMES_PER_SEC) {
+				lastPlanLog = f;
+				circuit->LOG("[ANV-EPLAN] f=%d incomeM %.1f ratio %.1f extraE %.0f -> %.0f | running %.0f idleFac %.0f builders %.0f (demandE %.0f demandM %.1f) -> %.0f | pull %.0f",
+					f, GetAvgMetalIncome(), ratio, extraE, plannedEnergy, running, idleFac, builders, demandE, demandM, running + idleFac + builders, GetEnergyPullReal());
+			}
+		}
+		plannedEnergy = std::max(plannedEnergy, running + idleFac + builders);
+	}
+	// the metal our income spends per energy that spending needs (consistent with the plan above)
+	spendMetalPerEnergy = (plannedEnergy > 0.f) ? GetAvgMetalIncome() / plannedEnergy : spendMetalPerEnergy;
+	spendMetalPerEnergy = (ratio > 0.f) ? 1.f / ratio : 0.f;
+}
