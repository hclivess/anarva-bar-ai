+AIFloat3 CSetupManager::GetEnemyStartCenter() const
+{
+	const geom::CRegion* ours = &circuit->GetAllyTeam()->GetStartBox();
+	AIFloat3 c(0.f, 0.f, 0.f);
+	int n = 0;
+	for (const auto& kv : setupData->GetBoxes()) {
+		if (kv.second == ours) continue;
+		const auto& b = kv.second->GetBox();
+		c.x += (b.left + b.right) / 2.f; c.z += (b.top + b.bottom) / 2.f; ++n;
+	}
+	if (n > 0) { c.x /= n; c.z /= n; }
+	return c;
+}
