+// A number from the game's setup script (e.g. the modoptions startmetal / startenergy), or the given default when
+// the setup doesn't set it (the game's own default, a game fact).
+static float Bridge_SetupNumber(const std::string& key, float dflt)
+{
+	const std::string script = bridgeAI->GetGame()->GetSetupScript();
+	const std::string k = key + "=";
+	size_t at = 0;
+	while ((at = script.find(k, at)) != std::string::npos) {
+		if (at == 0 || !isalnum((unsigned char)script[at - 1])) {
+			return std::strtof(script.c_str() + at + k.size(), nullptr);
+		}
+		at += k.size();
+	}
+	return dflt;
+}
