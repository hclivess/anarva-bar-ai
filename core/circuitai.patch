+		const float dUs = circuit->GetSetupManager()->GetBasePos().distance2D(sp);
+		const float dThem = circuit->GetEnemyManager()->GetEnemyBasePos().distance2D(sp);
+		const float keep = (dUs + dThem > 0.f) ? dThem / (dUs + dThem) : 1.f;
+		// the measured life is the mean over our producers: a spot lives it in proportion to its keep against theirs
+		{
+			float sk = 0.f; int nk = 0;
+			const springai::AIFloat3 bp = circuit->GetSetupManager()->GetBasePos(), ebp = circuit->GetEnemyManager()->GetEnemyBasePos();
+			for (auto& kv : circuit->GetTeamUnits()) {
+				const circuit::CCircuitDef* ud = kv.second->GetCircuitDef();
+				if (ud->IsMobile() || ud->GetExtractsM() <= 0.f) continue;
+				const springai::AIFloat3 up = kv.second->GetPos(circuit->GetLastFrame());
+				const float a = bp.distance2D(up), b = ebp.distance2D(up);
+				if (a + b > 0.f) { sk += b / (a + b); ++nk; }
+			}
+			keepShare = (nk > 0 && sk > 0.f) ? keep / (sk / nk) : 1.f;
+		}
+		// An extractor is worth what it extracts minus its upkeep (owner, 2026-11-26: "extractors are worth whatever they
+		// provide minus the maintenance cost"). Its metal counts in full: a full bank is answered by build power, not by
+		// fewer extractors - discounted while the bank floated, the start bank made early extractors worthless (one
+		// extractor at minute 4 on Feast and Canis). Upkeep is its energy draw at energy's price.
+		// ...but while energy binds, more metal can't be spent until energy catches up: production is the least of the
+		// two (owner). Then the metal counts at the share we can spend (pM). A full metal bank alone doesn't discount
+		// it (more build power answers that). Counted in full while energy bound, the lab made 8 units in 5 minutes at
+		// 50-100 E/s while extractors kept winning over wind (Canis 2026-11-26; replay model: energy lead decides).
+		const float spendable = AnarvaEnergyBinds(circuit) ? pM : 1.f;
+		// an upgrade replaces the extractor standing there: it yields only its extraction and upkeep over the old one's
+		// (counted whole, the upgrade read 4/3 of its worth). Anarva, #102.
+		float oldM = 0.f, oldUpE = 0.f;
+		if (task->GetBuildType() == circuit::IBuilderTask::BuildType::MEXUP) {
+			const circuit::CCircuitDef* t1 = circuit->GetEconomyManager()->GetSideInfo().mexDef;
+			if (t1 != nullptr) { oldM = t1->GetExtractsM(); oldUpE = std::max(0.f, t1->GetUpkeepE()); }
+		}
+		yield += circuit->GetMetalManager()->GetSpotAvgIncome() * std::max(0.f, bd->GetExtractsM() - oldM) * eco->GetExtractorScale() * keep * spendable;  // measured scale (was ~1/9 of real)
+		yield -= std::max(0.f, std::max(0.f, bd->GetUpkeepE()) - oldUpE) * pE;
+	}
+	// Energy is worth most when it is short: in a lull, if the turbines' drop leaves us short, energy binds and costs
+	// what production loses per energy. A plant's yield is its output at the price of each moment - a solar gives the
+	// same in both, a turbine little exactly when energy is dear (owner: "don't forget wind fluctuations"; Feast's
+	// wind at 4-8 for minutes, three stalls with wind chosen every time, 2026-11-25). All measured this game.
+	{
+		const float make = eco->GetEnergyMake(const_cast<circuit::CCircuitDef*>(bd));
+		if (make > 0.f) {
+			const float fL = eco->GetLullShare();
+			const float drop = (eco->GetWindMean() > 0.f) ? eco->GetWindTurbineIncome() * (1.f - eco->GetWindLow() / eco->GetWindMean()) : 0.f;
+			// the dear price holds only for the energy we would be short in a lull (the gap); beyond it, energy is worth
+			// the usual price. Applied to the whole output, every solar looked ~3x its worth and 2-4 constructors sat on
+			// an advanced solar for 4 minutes while extractors waited (owner: "what's your kink on not building
+			// extractors", Feast 2026-11-25).
+			const float pullE = eco->GetSmoothEnergyPull(), pullM = eco->GetSmoothMetalPull();
+			const float gap = std::max(0.f, pullE - (eco->GetAvgEnergyIncome() - drop));
+			const float pL = (gap > 0.f) && (pullE > 0.f) ? std::max(pE, pullM / pullE) : pE;
+			float lullOut = make, meanOut = make;
+			if (bd->IsWind() && (eco->GetWindMean() > 0.f)) {
+				const float scale = make / eco->GetWindMean();  // the turbine's share of the wind (its cap)
+				lullOut = scale * eco->GetWindLow();
+				meanOut = scale * (fL * eco->GetWindLow() + (1.f - fL) * eco->GetWindHigh());
+			}
+			// Production is the least of metal and energy (owner): energy is worth pE only up to what production will
+			// draw (the larger of the smoothed pull and the planned draw, less income); the rest is worth what a
+			// converter makes of it. All 300 E/s of a geothermal at pE made it beat every extractor at 2:53 - 560 metal,
+			// 2122 from base, killed at 6:12; 5 extractors at minute 4 vs winners' 9. Winners' first geo comes at 5:15
+			// at the earliest, 10:37 on average (replays.db, 31 of 107 1v1 winners; Canis 13:41, 5 games).
+			const float need = std::max(0.f, std::max(pullE, eco->GetPlannedEnergy()) - eco->GetAvgEnergyIncome());
+			const float pSurplus = std::min(pE, eco->GetEcoEM());
+			const float useful = std::min(meanOut, need);
+			yield += useful * pE + (meanOut - useful) * pSurplus + fL * (pL - pE) * std::min(lullOut, gap);
+			// and, like an extractor, a plant yields only while we keep its site (distance from our base vs theirs)
+			const springai::AIFloat3& sp = task->GetPosition();
+			if (geom::is_valid(sp)) {
+				const float dUs = circuit->GetSetupManager()->GetBasePos().distance2D(sp);
+				const float dThem = circuit->GetEnemyManager()->GetEnemyBasePos().distance2D(sp);
+				if (dUs + dThem > 0.f) yield *= dThem / (dUs + dThem);
+			}
+		}
+	}
+	// A job without a yield (lab, turret) is paid back by our income instead: the time our income needs to earn
+	// its cost. Without this it looked quicker than any extractor (no payback term) and the lab came first at 2 M/s.
+	// The job's own energy draw (owner: "build towers cost a lot of energy to construct" - a construction turret is
+	// 3200 E, a lab 950, an extractor 500). What the bank and our surplus cover over its build time is priced as
+	// usual; the rest is taken from production and costs what production loses per energy (metal spent per energy).
+	// At the non-binding price two turrets counted ~46 metal of energy each and energy stalled right after them
+	// (Gasbag minute 5, 2026-11-25).
+	float costE = bd->GetCostE() * pE;
+	{
+		const float netE = std::max(0.f, eco->GetAvgEnergyIncome() - eco->GetSmoothEnergyPull());
+		const float covered = eco->GetEnergyCur() + netE * std::max(1.f, build);
+		const float shortE = std::max(0.f, bd->GetCostE() - covered);
+		const float pullE = eco->GetSmoothEnergyPull(), pullM = eco->GetSmoothMetalPull();
+		const float pLose = (pullE > 0.f) ? std::max(pE, pullM / pullE) : pE;
+		costE = (bd->GetCostE() - shortE) * pE + shortE * pLose;
+	}
+	const float cost = bd->GetCostM() * pM + costE;
+	const bool producer = (bd->GetExtractsM() > 0.f) || (eco->GetEnergyMake(const_cast<circuit::CCircuitDef*>(bd)) > 0.f);
+	const float income = eco->GetAvgMetalIncome() * pM + eco->GetAvgEnergyIncome() * pE;
+	// Joining a job others build: its remaining work W finishes W/B - W/(B+b) sooner (B the build power on it, b ours),
+	// and its yield arrives that much sooner - what joining is worth. Scored as building it alone and dividing the value,
+	// joining always lost: our commander took solo jobs only, while the winners' commanders spend 27% of their time on
+	// REPAIR (assisting builds in progress) and 7% on GUARD (comm table, 23221 samples, 107 1v1 wins).
+	if (!task->GetAssignees().empty()) {
+		float B = 0.f;
+		for (circuit::CCircuitUnit* a : task->GetAssignees()) B += a->GetCircuitDef()->GetBuildSpeed();
+		float progress = 0.f;
+		if (task->GetTarget() != nullptr) progress = task->GetTarget()->GetUnit()->GetBuildProgress();
+		const float W = bd->GetBuildTime() * std::max(0.f, 1.f - progress);
+		float rate = producer ? yield : 0.f;
+		if (!producer && (bd->GetBuildSpeed() > 0.f)) {
+			circuit::CFactoryManager* fm = circuit->GetFactoryManager();
+			const float perBp = fm->GetMetalRequire() / std::max(1.f, fm->GetFactoryPower());
+			rate = std::min(AnarvaSpendable(circuit), bd->GetBuildSpeed() * std::max(perBp, 1e-3f));
+			// a mobile constructor in production: what it does first is claim an extractor, so finishing it sooner gets
+			// one extractor's yield sooner - the same the helper gets by claiming a spot itself. Valued as build power,
+			// constructors assisted the next constructor 35 times while metal sat at 6.6 M/s from 2:00 to 4:00 (swe1)
+			const circuit::CCircuitDef* mexDef = circuit->GetEconomyManager()->GetSideInfo().mexDef;
+			if (bd->IsMobile() && (mexDef != nullptr) && bd->CanBuild(const_cast<circuit::CCircuitDef*>(mexDef))) {
+				rate = circuit->GetMetalManager()->GetSpotAvgIncome() * mexDef->GetExtractsM() * circuit->GetEconomyManager()->GetExtractorScale();
+			}
+		}
+		if ((B > 0.f) && (rate > 0.f) && (builderBp > 0.f)) {
+			// ...as fast as our resources feed it: each resource feeds a share of the build power - its income plus what its
+			// bank gives over the job, over what the builders draw - and build power beyond what is fed finishes nothing
+			// sooner. Unfed, the commander assisted the plant's constructor for ~60 s with energy at 0/1150 and 50 E/s, the
+			// constructor took 48 s and no plant was built (swe37)
+			const float tJob = W / (B + builderBp);
+			const float pullE = std::max(1e-3f, eco->GetEnergyPullReal()), pullM = std::max(1e-3f, eco->GetMetalPull());
+			const float feedE = (eco->GetAvgEnergyIncome() + eco->GetEnergyCur() / std::max(1.f, tJob)) / pullE;
+			const float feedM = (eco->GetAvgMetalIncome() + eco->GetMetalCur() / std::max(1.f, tJob)) / pullM;
+			const float R = B * std::min(feedE, feedM);  // the build power on this job the resources can carry
+			const float sooner = W / std::max(1e-3f, std::min(B, R)) - W / std::max(1e-3f, std::min(B + builderBp, R));
+			const float V = rate * sooner;
+			return (V > 0.f) ? (travel + W / (B + builderBp)) / V : 1e9f;
+		}
+	}
+	// Build power (a construction turret, a factory) is worth the metal it lets us spend that would otherwise
+	// overflow: min(overflow, its build power x the metal factories spend per build power) over the horizon. Counted at
+	// its cost, it never beat an extractor while metal sat full at 1350/1350 for minutes and the army stayed a tenth of
+	// the winners' (round 19, 2026-11-25). Players add production when metal floats.
+	if (!producer && bd->GetBuildSpeed() > 0.f) {
+		// income we earn and don't spend, from the moment it appears (not only once storage is full: that reacted
+		// minutes late and flickered - the guides keep build power matched to income, ~200 per 5 metal/s)
+		const float overflow = AnarvaSpendable(circuit);
+		circuit::CFactoryManager* fm = circuit->GetFactoryManager();
+		const float facBp = std::max(1.f, fm->GetFactoryPower());
+		const float perBp = fm->GetMetalRequire() / facBp;
+		// Build power for a factory is worth the metal it puts through the factory: leftover metal in full, and metal it
+		// takes from the builders' jobs at what the army is worth over them per metal (production's values, script).
+		// On leftover metal alone, a spent bank read 0 and no caretaker came: lr2 had 42.7 M/s, one lab, 0 caretakers
+		// and an army of 324 vs 2020 at 8:00.
+		const float bpRate = bd->GetBuildSpeed() * std::max(perBp, 1e-3f);
+		const float fromLeft = std::min(overflow, bpRate);
+		const float armyV = circuit->GetMilitaryManager()->armyPerMetal, builderV = circuit->GetMilitaryManager()->builderPerMetal;
+		const float edge = (armyV > 0.f) ? std::max(0.f, armyV - builderV) / armyV : 0.f;  // share of a redirected metal's worth gained
+		const float fromBuilders = std::min(std::max(0.f, bpRate - fromLeft), std::max(0.f, eco->GetSmoothMetalPull() - fm->GetMetalRequire())) * edge;
+		// a factory of a kind we don't have is worth its units: the metal it will turn into them x the share by which its
+		// best unit beats the best we can build now (LabVsEnemy). As build power alone the vehicle plant's value swung
+		// +1061 -> -489 with the bank and builders dropped it 41 times (tr1); winners' second factories are vehicle or
+		// air plants (78 of 94) and their vehicles kill BARb's Pounders and Brutes (REPLAYS.md)
+		const float fromUnits = bpRate * circuit->GetMilitaryManager()->GetFactoryEdge(bd);
+		const float gain = fromLeft + fromBuilders + fromUnits;
+		const float V = gain * (H - busy) - cost;
+		{  // Anarva: the inputs of a build-power job's value, once per 10 s per type (a second lab lost every pick, cmd_m60)
+			static int lastLog = -1000000;
+			const int f = circuit->GetLastFrame();
+			if (f - lastLog >= 300) {
+				lastLog = f;
+				circuit->LOG("[ANV-BPVAL] f=%d %s overflow %.1f perBp %.3f (facMetal %.1f facPower %.0f) bp %.0f gain %.1f H %.0f busy %.0f cost %.0f V %.0f",
+					f, bd->GetDef()->GetName(), overflow, perBp, fm->GetMetalRequire(), facBp, bd->GetBuildSpeed(), gain, H, busy, cost, V);
+			}
+		}
+		if (V > 0.f) return busy * share / V;
+	}
+	// A job whose ordering decision gave its value (a tower: the raid loss it prevents) competes on that value like a
+	// producer: as an urgent order it skipped the comparison and took the commander from extractors and wind twice
+	// before minute 2.5 (winners build 0.2 towers by 3:00, 8.4 turbines and 5 extractors: replays.db, 107 wins).
+	if (task->GetAnarvaValue() > 0.f) {
+		const float V = task->GetAnarvaValue() - cost;
+		return (V > 0.f) ? busy * share / V : 1e9f;
+	}
+	if (!producer) {
+		// A building without a yield (lab, turret, nano) was ordered by a decision that judged it worth at least its
+		// cost; the builder also waits for what we don't hold yet (paid from stock first, then income: banked metal is
+		// idle capital - the lab waited for income to "earn" 1150 banked metal, 2026-11-25).
+		const float stock = eco->GetMetalCur() * pM + eco->GetEnergyCur() * pE;
+		const float owed = std::max(0.f, cost - stock);
+		const float wait = (owed > 0.f) ? owed / std::max(1e-3f, income) : 0.f;
+		return (busy + wait) * share / std::max(1e-3f, cost);
+	}
+	// a producer is worth its yield from when it is done to the end of the horizon - or until it dies, at the producer
+	// life we have measured (feedback, owner: "ignores losses? is there no feedback loop?"; constructors rebuilt
+	// extractors 3400-4570 from base that Gators killed at once, 399 extractor picks for 5 extractors, fb2) - less its cost
+	const float lifeM = circuit->GetMilitaryManager()->GetProducerLife();
+	const float window = (lifeM > 0.f) ? std::min(H - busy, lifeM * keepShare) : (H - busy);
+	const float V = yield * window - cost;
+	if (V <= 0.f) {
+		return 1e9f;  // pays nothing back within the horizon at these prices (e.g. an extractor while metal overflows)
+	}
+	return busy * share / V;
+}
