+// Wrecks and other reclaimable features: position, metal left, can it be resurrected.
+static asUINT Bridge_GetWrecks(CScriptArray* pos, CScriptArray* metal, CScriptArray* rez)
+{
+	COOAICallback* clb = bridgeAI->GetCallback();
+	springai::Resource* metalRes = bridgeAI->GetEconomyManager()->GetMetalRes();
+	std::vector<springai::Feature*> features = clb->GetFeatures();
+	pos->Resize(0); metal->Resize(0); rez->Resize(0);
+	for (springai::Feature* f : features) {
+		springai::FeatureDef* fd = f->GetDef();
+		if (fd != nullptr) {
+			const float m = fd->IsReclaimable() ? fd->GetContainedResource(metalRes) * f->GetReclaimLeft() : 0.f;
+			if (m >= 1.f) {
+				AIFloat3 p = f->GetPosition();
+				bool r = clb->Feature_IsResurrectable(f->GetFeatureId());
+				pos->InsertLast(&p); metal->InsertLast((void*)&m); rez->InsertLast(&r);
+			}
+			delete fd;
+		}
+	}
+	utils::free_clear(features);
+	return pos->GetSize();
+}
+
+// Unit ids of the enemies AiGetEnemies returns, in the same order (call in the same frame).
+// An id that disappears from the list died (the core drops an enemy only when it is destroyed).
+static asUINT Bridge_GetEnemyIds(CScriptArray* ids)
+{
+	const CCircuitAI::EnemyInfos& enemies = bridgeAI->GetEnemyInfos();
+	ids->Resize(0);
+	for (auto& kv : enemies) {
+		if (kv.second->IsHidden()) continue;
+		int id = kv.first;
+		ids->InsertLast(&id);
+	}
+	return ids->GetSize();
+}
+
+// Every metal spot: position, income, open (not ours or queued by us/allies).
+static asUINT Bridge_GetMetalSpots(CScriptArray* pos, CScriptArray* income, CScriptArray* open)
+{
+	CMetalManager* mm = bridgeAI->GetMetalManager();
+	const CMetalData::Metals& spots = mm->GetSpots();
+	const asUINT n = spots.size();
+	pos->Resize(n); income->Resize(n); open->Resize(n);
+	for (asUINT i = 0; i < n; ++i) {
+		AIFloat3 p = spots[i].position;
+		float inc = spots[i].income;
+		bool o = mm->IsOpenSpot(int(i));
+		pos->SetValue(i, &p); income->SetValue(i, &inc); open->SetValue(i, &o);
+	}
+	return n;
+}
+
+// Do we see this spot right now (our line of sight, as of the core's last LOS refresh)?
+
+// Anarva: what an energy plant actually makes on this map: its fixed make, tidal generators at the map's tidal
+// strength, wind generators at the map's average wind (capped by the generator's own maximum).
+static float Bridge_EnergyMake(CCircuitDef* cdef)
+{
+	if (cdef == nullptr) {
+		return 0.f;
+	}
+	springai::Resource* e = bridgeAI->GetEconomyManager()->GetEnergyRes();
+	springai::UnitDef* def = cdef->GetDef();
+	CMap* map = bridgeAI->GetMap();
+	const float avgWind = 0.5f * (map->GetMinWind() + map->GetMaxWind());
+	return def->GetResourceMake(e)
+		+ def->GetTidalResourceGenerator(e) * map->GetTidalStrength()
+		+ std::min(def->GetWindResourceGenerator(e), avgWind) * (def->GetWindResourceGenerator(e) > 0.f ? 1.f : 0.f);
+}
+
+static bool Bridge_IsInLOS(const AIFloat3& pos)
+{
+	AIFloat3 p = pos;
+	CTerrainManager::CorrectPosition(p);
+	return bridgeAI->GetMapManager()->IsInLOS(p);
+}
+
+static float Bridge_GetElevation(float x, float z)
+{
+	const float w = CTerrainManager::GetTerrainWidth() - 1.f, h = CTerrainManager::GetTerrainHeight() - 1.f;
+	return bridgeAI->GetTerrainManager()->GetAreaData()->GetElevationAt(std::clamp(x, 0.f, w), std::clamp(z, 0.f, h));
+}
+static float Bridge_MaxElevation() { return bridgeAI->GetTerrainManager()->GetAreaData()->maxElevation; }
+static float Bridge_MinElevation() { return bridgeAI->GetTerrainManager()->GetAreaData()->minElevation; }
+
+static float Bridge_ThreatAt(CThreatMap* map, CCircuitUnit* unit, const AIFloat3& pos)
+{
+	AIFloat3 p = pos;
+	CTerrainManager::CorrectPosition(p);
+	return map->GetThreatAt(unit, p);
+}
+
+static float Bridge_ThreatAtDef(CThreatMap* map, CCircuitDef* cdef, const AIFloat3& pos)
+{
+	// threat a unit of this type would face here (any of our units of that type stands in for it)
+	AIFloat3 p = pos;
+	CTerrainManager::CorrectPosition(p);
+	map->SetThreatType(cdef);
+	return map->GetThreatAt(p);
+}
