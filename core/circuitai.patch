+float CEconomyManager::GetEnergyPullReal()
+{
+	float use = 0.f;
+	for (const auto& kv : circuit->GetTeamUnits()) {
+		CCircuitUnit* u = kv.second;
+		if (u->GetCircuitDef()->IsMobile()) {
+			continue;
+		}
+		const SConvertExt* ce = convertDefs.GetAvailInfo(u->GetCircuitDef());
+		if (ce != nullptr) {
+			use += ce->energyUse;
+		}
+	}
+	const float pull = GetEnergyPull();
+	return std::max(0.f, pull - std::min(use, pull));
+}
