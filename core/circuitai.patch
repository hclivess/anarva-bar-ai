+static float AnarvaSpendable(circuit::CCircuitAI* circuit)
+{
+	circuit::CEconomyManager* eco = circuit->GetEconomyManager();
+	circuit::CFactoryManager* fm = circuit->GetFactoryManager();
+	// banked metal is idle capital: over the horizon build power can spend the surplus income and the bank (owner:
+	// "any metal excess asks for more build power"). Counting income alone, 390 metal sat in the bank from minute
+	// 1.5 to 3 while the winners spend theirs into units and turbines (Theta 2026-11-25).
+	// (The bank was counted as idle capital too: at 48 s the start metal made a second lab the best job - two labs
+	// before any energy (owner's Anarva-vs-Anarva game, 2026-11-25: "you built two labs..."). The start bank is the
+	// opener's; a filling bank is priced through metal floating instead.)
+	// Once production has started (a factory's first unit exists), banked metal is spendable by more build power just
+	// as surplus income is: over the horizon it adds the bank. Before that the start bank is the opener's (counted from
+	// 48 s, before the lab had made anything, it built a second lab). Without the bank, ~950 metal sat at minute 5 and
+	// the first construction turret came at 7-9 min vs the winners' 4.7 (replays.db, 102/107 wins).
+	float bank = 0.f;
+	{
+		bool producing = false;
+		for (auto& kv : circuit->GetTeamUnits()) {
+			const circuit::CCircuitDef* d = kv.second->GetCircuitDef();
+			if (d->IsMobile() && !d->IsRoleComm() && !kv.second->GetUnit()->IsBeingBuilt()) { producing = true; break; }
+		}
+		// spent over the time a builder commits to one job, not the planning horizon (~10700 s early: 471 banked read
+		// ~0 and no caretaker came while the lab fell behind, swe11) - as the energy plan counts the bank (en1-3)
+		if (producing) bank = eco->GetMetalCur() / std::max(1.f, AnarvaJobWindow(circuit));
+	}
+	const float mOver = std::max(0.f, eco->GetAvgMetalIncome() - eco->GetSmoothMetalPull()) + bank;
+	// the energy that spending draws: our surplus plus the bank spread over a job's time, at the factories' E per M
+	const float eOver = std::max(0.f, eco->GetAvgEnergyIncome() - eco->GetSmoothEnergyPull())
+		+ eco->GetEnergyCur() / AnarvaJobWindow(circuit);
+	const float ePerM = (fm->GetMetalRequire() > 0.f) ? fm->GetEnergyRequire() / fm->GetMetalRequire() : 0.f;
+	return (ePerM > 0.f) ? std::min(mOver, eOver / ePerM) : mOver;
+}
