+// Anarva (#86): the energy needed to spend our metal income, at the E/M of what we build. Computed on its own, once per
+// frame, wherever it is read: inside UpdateEnergyTasks it went stale whenever the job queue was busy (early return),
+// and the builders priced energy at the converter rate while we were short (Throne/Eye of Horus 2026-11-25).
+void CEconomyManager::UpdateWind()
+{
+	const int f = circuit->GetLastFrame();
+	if (windCap <= 0.f) {
+		for (const auto& i : energyDefs.GetInfos()) {
+			if (i.cdef->IsWind()) windCap = std::max(windCap, i.cdef->GetDef()->GetWindResourceGenerator(energyRes));
+		}
+		if (windCap <= 0.f) return;
+	}
+	if (windFrame < 0) { windFrame = f; return; }
+	const float dt = float(f - windFrame);
+	windFrame = f;
+	if (dt <= 0.f) return;
+	const float w = std::min(circuit->GetMap()->GetCurWind(), windCap);
+	const float mean = (windT > 0.f) ? windSum / windT : w;
+	windT += dt; windSum += w * dt;
+	if (w < mean) {
+		lowT += dt; lowSum += w * dt;
+		if (!inLull) { inLull = true; ++lullCount; }
+	} else {
+		inLull = false;
+	}
+	if (f / (60 * FRAMES_PER_SEC) != (f - int(dt)) / (60 * FRAMES_PER_SEC)) {
+		circuit->LOG("[ANV-WIND] t=%im now %.1f mean %.1f lull %.1f for %.0f s (map %.0f-%.0f, turbine cap %.0f)", f / (60 * FRAMES_PER_SEC),
+			w, GetWindMean(), GetWindLow(), GetLullSeconds(), circuit->GetMap()->GetMinWind(), circuit->GetMap()->GetMaxWind(), windCap);
+	}
+}
+
+// The map's wind range is what a player knows before the game (Theta 0-16: winners build 9.4 turbines by 3:00,
+// replays.db); this game's wind refines it. The range's midpoint counts as one observation, each completed lull
+// cycle as one more (2 minutes at 3.6 chose an advanced solar on Theta, 2026-11-25).
+static float AnarvaBlend(float prior, float observed, int n) { return (prior + observed * float(n)) / (1.f + float(n)); }
+
+float CEconomyManager::GetWindMean() const
+{
+	const float cap = (windCap > 0.f) ? windCap : 1e9f;
+	const float prior = std::min(cap, (circuit->GetMap()->GetMaxWind() + circuit->GetMap()->GetMinWind()) * 0.5f);
+	return (windT > 0.f) ? AnarvaBlend(prior, windSum / windT, lullCount) : prior;
+}
+
+float CEconomyManager::GetWindLow() const
+{
+	const float cap = (windCap > 0.f) ? windCap : 1e9f;
+	const float mid = (circuit->GetMap()->GetMaxWind() + circuit->GetMap()->GetMinWind()) * 0.5f;
+	const float prior = std::min(cap, (circuit->GetMap()->GetMinWind() + mid) * 0.5f);  // the lower half's mean
+	return (lowT > 0.f) ? AnarvaBlend(prior, lowSum / lowT, lullCount) : prior;
+}
+
+float CEconomyManager::GetLullSeconds() const
+{
+	return (lullCount > 0) ? lowT / float(lullCount) / FRAMES_PER_SEC : 0.f;
+}
+
+float CEconomyManager::GetWindTurbineIncome() const
+{
+	int n = 0;
+	for (auto& kv : circuit->GetTeamUnits()) {
+		CCircuitUnit* u = kv.second;
+		if (u->GetCircuitDef()->IsWind() && !u->GetUnit()->IsBeingBuilt()) ++n;
+	}
+	return float(n) * GetWindMean();
+}
