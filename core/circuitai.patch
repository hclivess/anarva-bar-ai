+// Anarva (switch focusFire): Lanchester target order. Each unit focuses the visible enemy inside its own range whose
+// removal cuts the enemy's firepower most per point of damage we spend: threat / remaining health (ties: metal per
+// health). Set-target keeps the unit's movement orders.
+static void AnarvaFocusFire(CCircuitAI* circuit, const std::set<CCircuitUnit*>& units, const int frame)
+{
+	const CCircuitAI::EnemyInfos& enemies = circuit->GetEnemyInfos();
+	// Anarva (#44): a kill also removes what its death explosion destroys. Threat a target's blast takes from its
+	// neighbours: each enemy within the blast radius loses min(1, blast damage / its health) of its threat; our own
+	// units in the blast count against it the same way.
+	std::vector<CEnemyInfo*> seen;
+	for (auto& kv : enemies) {
+		if ((kv.second->GetCircuitDef() != nullptr) && kv.second->IsInLOS()) {
+			seen.push_back(kv.second);
+		}
+	}
+	std::unordered_map<CEnemyInfo*, float> chain;
+	for (CEnemyInfo* e : seen) {
+		CCircuitDef* edef = e->GetCircuitDef();
+		const float aoe = edef->deathAoe, dmg = edef->deathDamage;
+		if ((aoe <= 0.f) || (dmg <= 0.f)) {
+			continue;
+		}
+		float c = 0.f;
+		for (CEnemyInfo* n : seen) {
+			if ((n == e) || (n->GetPos().SqDistance2D(e->GetPos()) > SQUARE(aoe))) {
+				continue;
+			}
+			c += std::min(1.f, dmg / std::max(1.f, n->GetHealth())) * n->GetCircuitDef()->GetDefThreat();
+		}
+		for (CCircuitUnit* u : units) {
+			if (u->GetPos(frame).SqDistance2D(e->GetPos()) <= SQUARE(aoe)) {
+				c -= std::min(1.f, dmg / std::max(1.f, u->GetUnit()->GetHealth())) * u->GetCircuitDef()->GetDefThreat();
+			}
+		}
+		chain[e] = c;
+	}
+	for (CCircuitUnit* unit : units) {
+		const AIFloat3& up = unit->GetPos(frame);
+		const float range = unit->GetCircuitDef()->GetMaxRange();
+		CEnemyInfo* best = nullptr;
+		float bestScore = -1.f, bestTie = -1.f;
+		for (auto& kv : enemies) {
+			CEnemyInfo* e = kv.second;
+			CCircuitDef* edef = e->GetCircuitDef();
+			if ((edef == nullptr) || !e->IsInLOS() || (up.SqDistance2D(e->GetPos()) > SQUARE(range))) {
+				continue;
+			}
+			const float hp = std::max(1.f, e->GetHealth());
+			auto it = chain.find(e);
+			const float score = (edef->GetDefThreat() + ((it != chain.end()) ? it->second : 0.f)) / hp;  // threat removed per damage dealt
+			const float tie = edef->GetCostM() / hp;
+			if ((score > bestScore) || ((score == bestScore) && (tie > bestTie))) {
+				bestScore = score;
+				bestTie = tie;
+				best = e;
+			}
+		}
+		if (best != nullptr) {
+			unit->CmdSetTarget(best);
+		}
+	}
+}
