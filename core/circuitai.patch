+// side every flight time, so it is never where the shell lands. Instant weapons (beams) are not dodged.
+static AIFloat3 AnarvaDodge(CCircuitAI* circuit, CCircuitUnit* unit, const AIFloat3& spot, const int frame)
+{
+	CCircuitDef* udef = unit->GetCircuitDef();
+	const float v = udef->GetSpeed();
+	if (v <= 0.f) {
