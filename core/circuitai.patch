+// Energy binds only when our stock would run dry within that window at the demand we have: a full bank proves it
+// doesn't, whatever is requested (pull 1151 vs income 505 with 2399/2404 banked, Gasbag 2026-11-25 - the second lab
+// stood half-built for 3 minutes because build power looked worthless).
+static bool AnarvaEnergyBinds(circuit::CCircuitAI* circuit)
+{
+	// A player sees the bank draining and builds energy before it is empty: energy binds when the bank runs dry before
+	// all our build power could build the plants that close the deficit (plus the job at hand). One job's length
+	// alone looked 6 s ahead; the bank held 777 at minute 1.4 and was empty at minute 2.3 (Feast, 2026-11-25).
+	circuit::CEconomyManager* eco = circuit->GetEconomyManager();
+	// Wind fluctuates (owner): in a lull our turbines give the lull's output, for as long as a lull lasts (both measured
+	// this game). The bank has to carry that gap, or production stalls.
+	const float windDrop = (eco->GetWindMean() > 0.f) ? eco->GetWindTurbineIncome() * (1.f - eco->GetWindLow() / eco->GetWindMean()) : 0.f;
+	const float lullGap = std::max(0.f, eco->GetSmoothEnergyPull() - (eco->GetAvgEnergyIncome() - windDrop));
+	if (lullGap * eco->GetLullSeconds() > eco->GetEnergyCur()) return true;
+	// the demand we see coming counts, not only today's pull: the forecast (the factories' full draw) saw the lab's
+	// draw before the bank fell (Gasbag minute 1-2: priced short at 0.376, stalled 124/s a minute later)
+	const float deficit = std::max(eco->GetSmoothEnergyPull(), eco->GetPlannedEnergy()) - eco->GetAvgEnergyIncome();
+	if (deficit <= 0.f) return false;
+	const float tDry = eco->GetEnergyCur() / deficit;
+	const float perEps = eco->GetEnergyBuildTimePerEps();
+	const float bp = std::max(1.f, circuit->GetBuilderManager()->GetBuildPower());
+	const float tFix = (perEps > 0.f) ? deficit * perEps / bp : 0.f;
+	return tDry <= tFix + AnarvaJobWindow(circuit);
+}
