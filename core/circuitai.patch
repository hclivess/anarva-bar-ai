+// Wrecks and other reclaimable features: position, metal left, can it be resurrected.
+static asUINT Bridge_GetWrecks(CScriptArray* pos, CScriptArray* metal, CScriptArray* rez)
+{
+	COOAICallback* clb = bridgeAI->GetCallback();
+	springai::Resource* metalRes = bridgeAI->GetEconomyManager()->GetMetalRes();
+	std::vector<springai::Feature*> features = clb->GetFeatures();
+	pos->Resize(0); metal->Resize(0); rez->Resize(0);
+	for (springai::Feature* f : features) {
+		springai::FeatureDef* fd = f->GetDef();
+		if (fd != nullptr) {
+			const float m = fd->IsReclaimable() ? fd->GetContainedResource(metalRes) * f->GetReclaimLeft() : 0.f;
+			if (m >= 1.f) {
+				AIFloat3 p = f->GetPosition();
+				bool r = clb->Feature_IsResurrectable(f->GetFeatureId());
+				pos->InsertLast(&p); metal->InsertLast((void*)&m); rez->InsertLast(&r);
+			}
+			delete fd;
+		}
+	}
+	utils::free_clear(features);
+	return pos->GetSize();
+}
