+	for (auto& kv : circuit->GetEnemyInfos()) {
+		CEnemyInfo* e = kv.second;
+		CCircuitDef* edef = e->GetCircuitDef();
+		if ((edef == nullptr) || !e->IsInLOS()) {
+			continue;
+		}
+		const float d = up.distance2D(e->GetPos());
+		if (d > edef->GetMaxRange()) {
+			continue;
+		}
+		const float shot = edef->GetShotSpeed();
+		if (shot <= 0.f) {
+			continue;  // instant hit
+		}
+		const float flight = d / shot;
+		if (flight * v <= edef->GetAoe() + udef->GetRadius()) {
+			continue;  // too fast to dodge
+		}
+		if (edef->GetDefThreat() > worstThreat) {
+			worstThreat = edef->GetDefThreat();
+			worstFlight = flight;
+			worst = e;
+		}
+	}
+	if (worst == nullptr) {
+		return spot;
+	}
+	AIFloat3 dir = worst->GetPos() - up;
+	dir.y = 0.f;
+	const float len = std::max(1.f, dir.Length2D());
+	const AIFloat3 side(-dir.z / len, 0.f, dir.x / len);
+	const int period = std::max(1, (int)(worstFlight * FRAMES_PER_SEC));
+	const float sign = ((frame / period) % 2 == 0) ? 1.f : -1.f;
+	AIFloat3 out = spot + side * (sign * v * worstFlight);
+	CTerrainManager::CorrectPosition(out);
+	return out;
+}
