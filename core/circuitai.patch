diff --git a/src/circuit/util/AnarvaDecide.h b/src/circuit/util/AnarvaDecide.h
new file mode 100644
index 00000000..96dd9115
--- /dev/null
+++ b/src/circuit/util/AnarvaDecide.h
@@ -0,0 +1,210 @@
+/*
+ * AnarvaDecide.h
+ *
+ * Systematic replacements for the core's dice (switch anarva::switches.decide). No randomness: a choice among
+ * weighted candidates goes to the one furthest below its target share of what we have.
+ */
+
+#ifndef SRC_CIRCUIT_UTIL_ANARVADECIDE_H_
+#define SRC_CIRCUIT_UTIL_ANARVADECIDE_H_
+
+#include "unit/CircuitDef.h"
+#include "unit/CircuitUnit.h"
+#include "map/ThreatMap.h"
+#include "map/InfluenceMap.h"
+#include "setup/SetupManager.h"
+#include "CircuitAI.h"
+
+#include <vector>
+#include <limits>
+
+namespace circuit {
+namespace anarva {
+
+// Largest deficit: target share = weight / total weight; current share = alive count x metal cost / total over
+// the candidates. Returns the index furthest below its target (ties: the cheaper). With no weights at all, the
+// cheapest candidate. -1 if empty.
+template <class T, class GetDef, class GetWeight>
+int DeficitPick(const std::vector<T>& cands, GetDef getDef, GetWeight getWeight)
+{
+	if (cands.empty()) {
+		return -1;
+	}
+	float sumW = 0.f, sumHave = 0.f;
+	for (const T& c : cands) {
+		sumW += getWeight(c);
+		const CCircuitDef* d = getDef(c);
+		sumHave += d->GetCount() * d->GetCostM();
+	}
+	int best = -1;
+	float bestGap = -std::numeric_limits<float>::max();
+	for (int i = 0; i < (int)cands.size(); ++i) {
+		const CCircuitDef* d = getDef(cands[i]);
+		const float want = (sumW > 0.f) ? getWeight(cands[i]) / sumW : 0.f;
+		const float have = (sumHave > 0.f) ? d->GetCount() * d->GetCostM() / sumHave : 0.f;
+		const float gap = (sumW > 0.f) ? (want - have) : -d->GetCostM();
+		if ((gap > bestGap) || ((gap == bestGap) && (best >= 0) && (d->GetCostM() < getDef(cands[best])->GetCostM()))) {
+			bestGap = gap;
+			best = i;
+		}
+	}
+	return best;
+}
+
+
+// Retreat as a decision (replaces the random retreat health fraction). A damaged unit leaves when the fight where it
+// stands is going against us (enemy threat there above our influence) and it can still get out: its health lasts
+// longer under the incoming damage (the threat map's value there) than its trip home. If it can't get out, running
+// only wastes the damage it can still deal; if the fight is ours, it stays.
+inline bool ShouldRetreat(CCircuitAI* circuit, CCircuitUnit* unit)
+{
+	const int frame = circuit->GetLastFrame();
+	const springai::AIFloat3& pos = unit->GetPos(frame);
+	CThreatMap* threatMap = circuit->GetThreatMap();
+	threatMap->SetThreatType(unit);
+	const float incoming = threatMap->GetThreatAt(unit, pos);
+	if (incoming <= 0.f) {
+		return false;  // nothing can hit it here
+	}
+	const float ours = circuit->GetInflMap()->GetAllyInflAt(pos);
+	const float theirs = circuit->GetInflMap()->GetEnemyInflAt(pos);
+	if (ours > theirs) {
+		return false;  // the fight here is ours
+	}
+	const CCircuitDef* cdef = unit->GetCircuitDef();
+	const float health = unit->GetHealthPercent() * cdef->GetHealth();
+	const float tKill = health / incoming;
+	const float tHome = circuit->GetSetupManager()->GetBasePos().distance2D(pos) / std::max(1.f, cdef->GetSpeed());
+	return tKill > tHome;
+}
+
+
+// Enemy value a blast destroys around pos: enemies still inside the radius after `delay` seconds (they move by
+// speed x delay) each lose min(1, damage / health) of their metal; our own units inside count against it.
+inline float BlastValue(CCircuitAI* circuit, CCircuitUnit* self, const springai::AIFloat3& pos, float aoe, float damage, float delay)
+{
+	if ((aoe <= 0.f) || (damage <= 0.f)) {
+		return 0.f;
+	}
+	float v = 0.f;
+	for (auto& kv : circuit->GetEnemyInfos()) {
+		CEnemyInfo* e = kv.second;
+		CCircuitDef* ed = e->GetCircuitDef();
+		if ((ed == nullptr) || !e->IsInRadarOrLOS()) {
+			continue;
+		}
+		const float reach = aoe - ed->GetSpeed() * delay;
+		if ((reach > 0.f) && (e->GetPos().SqDistance2D(pos) <= reach * reach)) {
+			v += std::min(1.f, damage / std::max(1.f, e->GetHealth())) * ed->GetCostM();
+		}
+	}
+	const int frame = circuit->GetLastFrame();
+	for (auto& kv : circuit->GetTeamUnits()) {
+		CCircuitUnit* u = kv.second;
+		if ((u == self) || (u->GetPos(frame).SqDistance2D(pos) > aoe * aoe)) {
+			continue;
+		}
+		v -= std::min(1.f, damage / std::max(1.f, u->GetUnit()->GetHealth())) * u->GetCircuitDef()->GetCostM();
+	}
+	return v;
+}
+
+// Self-destruct (owner, #79: Fiends self-destruct for extra damage). Doomed (losing here and too slow to escape):
+// self-destruct when its self-d blast destroys more than its normal death blast would. Otherwise only when the blast
+// destroys more than what is left of the unit (its metal x health share).
+inline bool ShouldSelfD(CCircuitAI* circuit, CCircuitUnit* unit)
+{
+	CCircuitDef* cdef = unit->GetCircuitDef();
+	if ((cdef->selfdDamage <= 0.f) || !cdef->IsMobile()) {
+		return false;
+	}
+	const int frame = circuit->GetLastFrame();
+	const springai::AIFloat3& pos = unit->GetPos(frame);
+	const float selfd = BlastValue(circuit, unit, pos, cdef->selfdAoe, cdef->selfdDamage, float(cdef->GetSelfDCountdown()));
+	if (selfd <= 0.f) {
+		return false;
+	}
+	const float ours = circuit->GetInflMap()->GetAllyInflAt(pos);
+	const float theirs = circuit->GetInflMap()->GetEnemyInflAt(pos);
+	const bool doomed = (theirs >= ours) && !ShouldRetreat(circuit, unit);
+	if (doomed) {
+		return selfd > BlastValue(circuit, unit, pos, cdef->deathAoe, cdef->deathDamage, 0.f);
+	}
+	return selfd > cdef->GetCostM() * unit->GetHealthPercent();
+}
+
+// Reach of the cheapest armed structure this builder can make (what one turret holds), 0 if none
+inline float CheapestTurretReach(CCircuitAI* circuit, const CCircuitDef* builder)
+{
+	float reach = 0.f, cost = std::numeric_limits<float>::max();
+	if (builder == nullptr) {
+		return 0.f;
+	}
+	for (CCircuitDef::Id oId : builder->GetBuildOptions()) {
+		CCircuitDef* o = circuit->GetCircuitDef(oId);
+		if ((o != nullptr) && !o->IsMobile() && (o->GetPower() > 0.f) && (o->GetMaxRange() > 0.f) && (o->GetCostM() < cost)) {
+			cost = o->GetCostM();
+			reach = o->GetMaxRange();
+		}
+	}
+	return reach;
+}
+
+// Where a shooter stands: inside its reach by the distance the target can cover during one reload, so the target
+// can't step out of range between shots (a static target: the full reach).
+inline float Standoff(const CCircuitDef* shooter, const CCircuitDef* target, float reach)
+{
+	const float v = ((target != nullptr) && target->IsMobile()) ? target->GetSpeed() : 0.f;
+	const float slip = v * float(shooter->GetReloadTime()) / FRAMES_PER_SEC;
+	return std::max(0.f, reach - slip);
+}
+
+// Value of a unit per metal: a constructor by its build power, anything else by its fighting strength (Lanchester power).
+inline float ValuePerMetal(const CCircuitDef* d)
+{
+	if (d == nullptr) {
+		return 0.f;
+	}
+	const float cost = std::max(1.f, d->GetCostM());
+	return (!d->GetBuildOptions().empty() && (d->GetBuildSpeed() > 0.f)) ? d->GetBuildSpeed() / cost : d->GetPower() / cost;
+}
+
+// Anarva (#90): what killing an enemy is worth to us, in metal: what it cost them (energy at the converter rate)
+// plus, for a producer, what it would have yielded them over our planning horizon (extraction at the map's mean spot,
+// energy and metal make). Every known unit and building is valued this way, nothing from a list.
+inline float TargetValue(CCircuitAI* circuit, const CCircuitDef* edef, float metalPerEnergy, float horizon,
+						 float spotIncome, springai::Resource* metalRes, springai::Resource* energyRes)
+{
+	if (edef == nullptr) {
+		return 0.f;
+	}
+	float v = edef->GetCostM() + edef->GetCostE() * metalPerEnergy;
+	springai::UnitDef* ud = edef->GetDef();
+	const float yield = edef->GetExtractsM() * spotIncome
+		+ ud->GetResourceMake(metalRes)
+		+ (ud->GetResourceMake(energyRes) + ud->GetWindResourceGenerator(energyRes) + ud->GetTidalResourceGenerator(energyRes)) * metalPerEnergy;
+	if (yield > 0.f) {
+		v += yield * horizon;
+	}
+	(void)circuit;
+	return v;
+}
+
+// Anarva (#90): (value - expected loss) per second it takes us. Expected loss by the square law: fighting threat T
+// with power P costs about our metal x (T/P)^2. Time = travel + the time our dps needs to kill it.
+inline float TargetScore(float value, float threat, float power, float ourMetal, float dist, float speed,
+						 float targetHealth, float ourDps)
+{
+	if (power <= threat) {
+		return -std::numeric_limits<float>::max();
+	}
+	const float ratio = threat / std::max(1e-6f, power);
+	const float loss = ourMetal * ratio * ratio;
+	const float t = dist / std::max(1.f, speed) + targetHealth / std::max(1e-3f, ourDps);
+	return (value - loss) / std::max(1.f, t);
+}
+
+} // namespace anarva
+} // namespace circuit
+
+#endif // SRC_CIRCUIT_UTIL_ANARVADECIDE_H_
