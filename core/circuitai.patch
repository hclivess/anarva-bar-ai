+// Anarva (#88): every builder pick is logged with the best job of each other type, in the same seconds, so every
+// economic choice can be read from the log.
+struct AnarvaPickLog {
+	std::map<int, std::pair<double, const circuit::IBuilderTask*>> best;
+	void Note(const circuit::IBuilderTask* t, double key) {
+		auto it = best.find((int)t->GetBuildType());
+		if ((it == best.end()) || (key < it->second.first)) {
+			best[(int)t->GetBuildType()] = std::make_pair(key, t);
+		}
+	}
+	void Write(circuit::CCircuitAI* circuit, circuit::CCircuitUnit* unit, const circuit::IBuilderTask* chosen) const {
+		if (chosen == nullptr) {
+			return;
+		}
+		auto name = [](const circuit::IBuilderTask* t) { return (t->GetBuildDef() != nullptr) ? t->GetBuildDef()->GetDef()->GetName() : "-"; };
+		std::string s;
+		for (const auto& kv : best) {
+			char buf[96];
+			snprintf(buf, sizeof(buf), " %d:%s=%s%.2f", kv.first, name(kv.second.second), (kv.second.first < 1e10) ? "NOW:" : "", 1000.0 * std::fmod(kv.second.first, 1e10));
+			s += buf;
+		}
+		circuit::CEconomyManager* eco = circuit->GetEconomyManager();
+		circuit->LOG("[ANV-PICK] f=%d %s -> %d:%s | best per type (type:def=builder-ms per metal of value):%s | M %.0f/%.0f E %.0f/%.0f | pM %.2f pE %.4f spendCap %.1f mInc %.1f mPull %.1f eInc %.0f ePullReal %.0f ePlanned %.0f",
+			circuit->GetLastFrame(), unit->GetCircuitDef()->GetDef()->GetName(), (int)chosen->GetBuildType(), name(chosen), s.c_str(),
+			eco->GetMetalCur(), eco->GetMetalStorage(), eco->GetEnergyCur(), eco->GetEnergyStorage(),
+			g_lastPM, g_lastPE, g_lastSpendCap, eco->GetAvgMetalIncome(), eco->GetMetalPull(), eco->GetAvgEnergyIncome(), g_lastRealPullE, g_lastPlanned);
+	}
+};
+// Priority band first, then seconds. Packed as band x 1e10 + seconds in a double (53-bit mantissa: bands up to 99
+// keep 1e-4 s resolution). It was band x 1e12 + seconds in a float (24 bits): the seconds vanished below the
+// float's resolution, every job in a band tied, and the loop's first type (energy) always won (smoke 2026-11-25).
+double AnarvaJobKey(float rank, float seconds)
+{
+	return double(rank) * 1e10 + std::min<double>(double(seconds), 1e9);
+}
+// Anarva: assisting the nearest factory, scored like any job (builder-seconds per metal of value): the income we
+// earn and don't spend that this builder's build power lets the factory spend, over the horizon, shared with the
+// builders already assisting it, plus the walk. (Guard jobs were only a fallback when nothing else was left: a lone
+// lab built 14 units in 7 minutes with metal full while players put the commander and constructors on it.)
+double AnarvaAssistKey(circuit::CCircuitAI* circuit, circuit::CCircuitUnit* unit, const std::set<circuit::CCircuitUnit*>& workers,
+	circuit::CCircuitUnit*& vip)
+{
+	using namespace circuit;
+	const int frame = circuit->GetLastFrame();
+	const AIFloat3& pos = unit->GetPos(frame);
+	vip = circuit->GetFactoryManager()->GetClosestFactory(pos);
+	if (vip == nullptr) return std::numeric_limits<double>::max();
+	CEconomyManager* eco = circuit->GetEconomyManager();
+	CFactoryManager* fm = circuit->GetFactoryManager();
+	const float overflow = AnarvaSpendable(circuit);
+	const float perBp = fm->GetMetalRequire() / std::max(1.f, fm->GetFactoryPower());
+	const float gain = std::min(overflow, unit->GetCircuitDef()->GetBuildSpeed() * std::max(perBp, 1e-3f));
+	if (gain <= 0.f) return std::numeric_limits<double>::max();
+	int k = 0;
+	for (CCircuitUnit* w : workers) {
+		if ((w == unit) || (w->GetTask() == nullptr) || (w->GetTask()->GetType() != IUnitTask::Type::BUILDER)) continue;
+		const CBGuardTask* g = dynamic_cast<const CBGuardTask*>(w->GetTask());
+		if ((g != nullptr) && (g->GetVipId() == vip->GetId())) ++k;
+	}
+	const float H = std::max(1.f, circuit->GetMilitaryManager()->GetValueHorizon());
+	const float travel = pos.distance2D(vip->GetPos(frame)) / std::max(1e-3f, unit->GetCircuitDef()->GetSpeed());
+	return AnarvaJobKey(1.f, (travel + H) * float(1 + k) / std::max(1e-6f, gain * H));
+}
